generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  COMPANY
  COLLEGE
  ADMIN
  FACULTY
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum InternshipMode {
  REMOTE
  HYBRID
  ON_SITE
}

/**
 * =========================================================
 * PHASE 12 — EMPLOYER PORTAL
 * =========================================================
 */

enum InternshipStatus {
  ACTIVE
  CLOSED
}

enum RoadmapStatus {
  COMPLETE
  CURRENT
  UPCOMING
}

enum SkillGapStatus {
  STRONG
  NEEDS_IMPROVEMENT
  MISSING
}

enum VerificationLevel {
  RESUME_DETECTED
  ASSESSMENT_VERIFIED
  PROJECT_VERIFIED
  INSTITUTION_VERIFIED
  EMPLOYER_VERIFIED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  company        Company?
  college        College?

  applications   Application[]
  facultyProfile FacultyProfile?
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  college            String?
  targetRole         String?
  readiness          Int      @default(0)
  passportShareable  Boolean  @default(false)
  passportShareToken String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /* Assignment (nullable): a student does NOT need a faculty member.
     null = unassigned; the student portal is fully usable either way.
     Set by the student's own College admin only (server-validated). */
  facultyId String?

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty            FacultyProfile?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  skills             StudentSkill[]
  resumes            Resume[]
  skillGaps          SkillGap[]
  roadmapItems       RoadmapItem[]
  assessmentAttempts AssessmentAttempt[]
  credentials        Credential[]
  enrollments        LearningEnrollment[]
  projectSubmissions ProjectSubmission[]
  studentCareers     StudentCareer[]
  facultyNotes       FacultyNote[]
  outcomes           Outcome[]
  employerFeedback   EmployerFeedback[]
}

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  industry    String?
  description String?
  website     String?
  location    String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  internships Internship[]

  outcomes          Outcome[]
  employerFeedbacks EmployerFeedback[]
}

model College {
  id                 String   @id @default(cuid())
  userId             String   @unique
  name               String
  studentsCount      Int      @default(0)
  placementReadiness Int      @default(0)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  facultyProfiles FacultyProfile[]
}

// ---------------------------------------------------------------------------
// Phase 14 — Faculty Portal
// A faculty member is a User with role FACULTY and a 1:1 FacultyProfile
// (the same session-derived resolution pattern as Company/College).
// Authorization scope: DIRECT ASSIGNMENT — a faculty member sees only the
// students explicitly assigned to them (StudentProfile.facultyId). Faculty
// without any assigned students see zero students — never a default
// institution. Assignment is managed exclusively by the student's own
// College admin (server-validated in college-admin-server.ts).
// ---------------------------------------------------------------------------

model FacultyProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  title      String?
  department String?
  collegeId  String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  college  College?         @relation(fields: [collegeId], references: [id])
  notes    FacultyNote[]
  students StudentProfile[]
}

model FacultyNote {
  id        String   @id @default(cuid())
  facultyId String
  studentId String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([facultyId, studentId])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  demand    String?
  createdAt DateTime @default(now())

  studentSkills    StudentSkill[]
  internshipSkills InternshipSkill[]
  skillGaps        SkillGap[]
  assessments      Assessment[]
  careerSkills     CareerSkill[]
  industryDemands  IndustryDemand[]
}

model StudentSkill {
  id                      String            @id @default(cuid())
  studentId               String
  skillId                 String
  score                   Int
  confidence              Int?
  evidence                String?
  evidenceSource          String?           @default("Resume")
  verificationLevel       VerificationLevel @default(RESUME_DETECTED)
  lastDemonstratedAt      DateTime?
  lastVerifiedAt          DateTime?
  assessmentScore         Int?
  projectEvidence         String?
  institutionVerification String?
  employerVerification    String?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
}

model Resume {
  id            String   @id @default(cuid())
  studentId     String
  fileName      String
  fileUrl       String?
  extractedText String?
  uploadedAt    DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model SkillGap {
  id        String         @id @default(cuid())
  studentId String
  skillId   String
  score     Int            @default(0)
  status    SkillGapStatus

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
}

model RoadmapItem {
  id         String        @id @default(cuid())
  studentId  String
  step       Int
  skill      String
  status     RoadmapStatus
  difficulty String?
  duration   String?
  resource   String?
  project    String?

  // Phase 8 — Personalized Career Roadmap fields
  currentScore Int?
  targetScore  Int?
  priority     Float?
  reason       String?
  activityType String?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, step])
}

model Internship {
  id          String         @id @default(cuid())
  companyId   String
  role        String
  location    String?
  mode        InternshipMode
  duration    String?
  stipend     String?
  description String?
  verified    Boolean        @default(false)

  // Phase 12 — Employer opportunity management
  openings Int?
  deadline DateTime?
  status   InternshipStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requiredSkills InternshipSkill[]
  applications   Application[]
  outcomes       Outcome[]
  employerFeedbacks EmployerFeedback[]
}

model InternshipSkill {
  id           String  @id @default(cuid())
  internshipId String
  skillId      String
  required     Boolean @default(true)

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([internshipId, skillId])
}

model Application {
  id           String            @id @default(cuid())
  studentId    String
  internshipId String
  status       ApplicationStatus @default(APPLIED)
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  outcomes          Outcome[]
  employerFeedbacks EmployerFeedback[]

  @@unique([studentId, internshipId])
}

enum QuestionType {
  MCQ
  CODING
  SQL
  SCENARIO
  PRACTICAL
}

enum AssessmentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectVerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model Assessment {
  id              String       @id @default(cuid())
  title           String       @unique
  skillName       String
  skillId         String?
  type            QuestionType @default(MCQ)
  category        String       @default("Technical")
  description     String
  difficulty      String       @default("INTERMEDIATE")
  passingScore    Int          @default(70)
  durationMinutes Int          @default(20)
  totalQuestions  Int          @default(10)
  language        String?
  status          String       @default("PUBLISHED")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  skill     Skill?               @relation(fields: [skillId], references: [id], onDelete: SetNull)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
}

model AssessmentQuestion {
  id            String       @id @default(cuid())
  assessmentId  String
  question      String
  questionType  QuestionType @default(MCQ)
  options       String[]     @default([])
  correctAnswer Int          @default(0)
  explanation   String?
  points        Int          @default(10)
  order         Int          @default(0)
  difficulty    String       @default("MEDIUM")
  topic         String?

  // Phase 4B Coding & Practical fields
  starterCode       String?
  solutionCode      String?
  language          String?
  testCases         Json?
  sampleInput       String?
  sampleOutput      String?
  constraints       String?
  functionSignature String?
  dbSchema          String?
  initialDbData     String?
  scenarioContext   Json?

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]
}

model AssessmentAttempt {
  id               String    @id @default(cuid())
  studentId        String
  assessmentId     String
  score            Int       @default(0)
  percentage       Int       @default(0)
  passed           Boolean   @default(false)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  attemptNumber    Int       @default(1)
  timeSpentSeconds Int       @default(0)
  correctCount     Int       @default(0)
  totalCount       Int       @default(0)
  details          Json?

  student    StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]
}

model AssessmentAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption Int?
  answerText     String?
  isCorrect      Boolean @default(false)
  pointsEarned   Int     @default(0)

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model ProjectSubmission {
  id            String                    @id @default(cuid())
  studentId     String
  title         String
  description   String
  skillName     String
  projectUrl    String?
  repoUrl       String?
  evidenceText  String?
  status        ProjectVerificationStatus @default(SUBMITTED)
  reviewerNotes String?
  score         Int?
  submittedAt   DateTime                  @default(now())
  verifiedAt    DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 15 — Outcomes / Feedback Ecosystem
// Outcomes are persisted records created ONLY through authorized server
// actions (an employer recording a result for its own opportunity/candidate).
// EmployerFeedback is stored SEPARATELY from StudentSkill so employer
// evidence is preserved alongside — never overwriting — existing verified
// skill scores.
// ---------------------------------------------------------------------------

enum OutcomeType {
  INTERNSHIP_COMPLETED
  JOB_OFFER
  HIRED
  NOT_SELECTED
  WITHDRAWN
}

enum OutcomeStatus {
  RECORDED
  VERIFIED
}

model Outcome {
  id                  String        @id @default(cuid())
  studentId           String
  companyId           String
  internshipId        String?
  applicationId       String?
  type                OutcomeType
  status              OutcomeStatus @default(RECORDED)
  occurredAt          DateTime      @default(now())
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  internship Internship?    @relation(fields: [internshipId], references: [id])
  application Application?  @relation(fields: [applicationId], references: [id])

  @@index([studentId])
  @@index([companyId])
  @@index([type])
}

model EmployerFeedback {
  id                        String  @id @default(cuid())
  companyId                 String
  studentId                 String
  internshipId              String?
  applicationId             String?
  technicalSkillsRating     Int?
  communicationRating       Int?
  problemSolvingRating      Int?
  professionalismRating     Int?
  roleReadinessRating       Int?
  writtenFeedback           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student    StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship Internship?       @relation(fields: [internshipId], references: [id])
  application Application?     @relation(fields: [applicationId], references: [id])

  @@index([companyId])
  @@index([studentId])
}

model Credential {
  id        String   @id @default(cuid())
  studentId String
  title     String
  type      String
  issuer    String   @default("SkillBridge")
  verified  Boolean  @default(true)
  score     Int?
  skills    String[]
  issuedAt  DateTime @default(now())
  url       String?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model LearningResource {
  id          String   @id @default(cuid())
  title       String
  provider    String
  skill       String
  difficulty  String
  duration    String
  type        String
  description String
  url         String
  createdAt   DateTime @default(now())
}

model IndustryProgram {
  id          String   @id @default(cuid())
  company     String
  title       String
  duration    String
  certificate Boolean  @default(true)
  description String
  skills      String[]
  eligibility String   @default("All Students")
  url         String?
  createdAt   DateTime @default(now())

  enrollments LearningEnrollment[]
}

model LearningEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  programId  String
  status     String   @default("ENROLLED")
  enrolledAt DateTime @default(now())

  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program IndustryProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([studentId, programId])
}

// ---------------------------------------------------------------------------
// Phase 5A — Career Selection & Career Profile Models
// ---------------------------------------------------------------------------

model Career {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  description String
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requiredSkills  CareerSkill[]
  studentCareers  StudentCareer[]
  industryDemands IndustryDemand[]
}

model CareerSkill {
  id         String @id @default(cuid())
  careerId   String
  skillId    String
  importance Int    @default(3)

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerId, skillId])
}

model StudentCareer {
  id        String  @id @default(cuid())
  studentId String
  careerId  String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  career  Career         @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([studentId, careerId])
}

// ---------------------------------------------------------------------------
// Phase 6A — Industry Demand Data Models
// ---------------------------------------------------------------------------

enum DemandLevel {
  HIGH
  GROWING
  EMERGING
  STABLE
  LOW
}

enum DemandSourceType {
  DEMO
  EMPLOYER_POSTINGS
  INDUSTRY_REPORT
  GOVERNMENT_DATA
  PARTNER_DATA
  MANUAL
}

enum DemandConfidence {
  HIGH
  MEDIUM
  LOW
}

model IndustryDemandEvidence {
  id String @id @default(cuid())

  industryDemandId String

  sourceType DemandSourceType
  sourceName String
  sourceUrl  String?

  metric          String?
  rawValue        String?
  normalizedValue Float?

  collectedAt DateTime  @default(now())
  validUntil  DateTime?

  notes String?

  industryDemand IndustryDemand @relation(fields: [industryDemandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industryDemandId])
  @@index([sourceType])
  @@index([collectedAt])
}

model IndustryDemand {
  id String @id @default(cuid())

  careerId String
  skillId  String

  demandLevel   DemandLevel
  demandScore   Int?
  confidence    DemandConfidence @default(LOW)
  evidenceCount Int              @default(0)

  sourceType DemandSourceType @default(DEMO)
  sourceName String?
  sourceUrl  String?

  collectedAt DateTime  @default(now())
  validUntil  DateTime?

  notes String?

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  evidence  IndustryDemandEvidence[]

  @@unique([careerId, skillId, sourceType])
  @@index([careerId])
  @@index([skillId])
  @@index([sourceType])
}
